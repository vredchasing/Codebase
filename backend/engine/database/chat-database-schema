-- 1. Users
CREATE TABLE users (
  user_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  username TEXT,
  email TEXT,
  -- additional profile fields
  metadata JSONB
);

-- 2. Chat Sessions
-- Create schema if it doesn't exist
CREATE SCHEMA IF NOT EXISTS user_chats;

CREATE TABLE user_chats.chat_sessions (
  session_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(user_id),
  started_at TIMESTAMP NOT NULL DEFAULT NOW(),
  ended_at TIMESTAMP NULL,
  status VARCHAR(50) NOT NULL,  -- e.g. 'active', 'closed'
  topic VARCHAR(255),
  metadata JSONB  -- free-form session metadata
);

-- 3. Messages (Turns)
CREATE TABLE user_chats.chat_messages (
  message_id BIGSERIAL PRIMARY KEY,
  session_id UUID NOT NULL REFERENCES user_chats.chat_sessions(session_id),
  sender_type VARCHAR(20) NOT NULL,  -- 'user' or 'agent' (or 'ai')
  sender_id UUID NULL, -- optional: if you want to link to a user or agent table
  content TEXT NOT NULL,
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  model_run_id UUID NULL  -- link to the model run if it was generated by the model
);

-- 4. Model Runs (LLM / Agent Invocations)
CREATE TABLE model_runs (
  model_run_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  session_id UUID NOT NULL REFERENCES user_chats.chat_sessions(session_id),
  prompt TEXT NOT NULL,
  response TEXT NOT NULL,
  model_name VARCHAR(100) NOT NULL,
  model_params JSONB,  -- e.g. temperature, max_tokens
  tokens_used INT,
  cost NUMERIC(10,4),  -- cost, if you're tracking it
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  metadata JSONB  -- e.g. retrieval docs, chain of thought, tool outputs
);

-- 5. Embeddings / Memory (optional)
-- Depending on your DB, `VECTOR` might be a supported type (e.g. in Postgres + pgvector), else store as bytea or JSON.
CREATE TABLE embeddings (
  embedding_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  message_id BIGINT REFERENCES messages(message_id),
  vector vector,  -- or binary / JSON
  created_at TIMESTAMP NOT NULL DEFAULT NOW(),
  metadata JSONB  -- e.g. chunk info, source doc
);

-- 6. Session Feedback (optional)
CREATE TABLE session_feedback (
  session_id UUID PRIMARY KEY REFERENCES user_chats.chat_sessions(session_id),
  rating INT CHECK (rating >= 1 AND rating <= 5),
  feedback TEXT,
  user_updated_at TIMESTAMP NOT NULL DEFAULT NOW()
);

-- 7. Agent / Tool Action Logs (if your AI agent calls tools)
CREATE TABLE agent_actions (
  action_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  model_run_id UUID NOT NULL REFERENCES model_runs(model_run_id),
  action_type VARCHAR(100),  -- e.g. 'API_CALL', 'SQL_QUERY'
  action_input JSONB,
  action_output JSONB,
  executed_at TIMESTAMP NOT NULL DEFAULT NOW()
);
